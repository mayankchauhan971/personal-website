---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { render } from 'astro:content';

const allNotes = await getCollection('weekly_notes');
const sortedNotes = allNotes.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});

// We'll render all notes on this page as a long stream
const renderedNotes = await Promise.all(
  sortedNotes.map(async (note) => {
    const { Content } = await render(note);
    return { ...note, Content };
  })
);

const pageTitle = "Weekly Notes | Mayank Chauhan";
const description = "An ongoing public log of reflections, lessons, experiments, and progress. Honest, thoughtful, and unpolished.";
---

<BaseLayout title={pageTitle} description={description}>
  <div class="max-w-3xl mx-auto px-6 py-16">
    <header class="mb-20">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-6 font-mono">
        Weekly Notes
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed max-w-2xl font-mono">
        A living archive of growth, reflections, and lessons. This is a space for honest, 
        unpolished thoughts on work, health, and curiosity. Updated weekly (mostly).
      </p>
    </header>

    <div class="space-y-24">
      {renderedNotes.map((note) => (
        <article class="relative">
          <!-- Timeline element -->
          <div class="absolute -left-12 top-0 bottom-0 w-px bg-gray-200 dark:bg-slate-800 hidden md:block"></div>
          <div class="absolute -left-[51px] top-2 w-2 h-2 rounded-full bg-yellow-500 hidden md:block"></div>

          <header class="mb-8">
            <div class="flex items-center gap-4 mb-2">
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white font-mono">
                Week {note.data.week}, {note.data.year}
              </h2>
            </div>
            <time class="text-sm text-gray-500 dark:text-gray-500 font-mono">
              {note.data.date && new Date(note.data.date).toLocaleDateString('en-US', {
                month: 'long',
                day: 'numeric',
                year: 'numeric'
              })}
            </time>
          </header>

          <div class="prose prose-slate dark:prose-invert prose-headings:font-mono prose-headings:text-xl prose-headings:mt-12 prose-headings:mb-6 prose-p:text-gray-600 dark:prose-p:text-gray-300 prose-p:mb-6 prose-li:text-gray-600 dark:prose-li:text-gray-300 prose-strong:text-gray-900 dark:prose-strong:text-white max-w-none">
            <note.Content />
          </div>
        </article>
      ))}
    </div>

    {renderedNotes.length === 0 && (
      <div class="text-center py-20 border border-dashed border-gray-300 dark:border-slate-700 rounded-lg">
        <p class="text-gray-500 dark:text-gray-400 font-mono">No weekly notes yet. The journey begins soon.</p>
      </div>
    )}

  </div>
</BaseLayout>

<style is:global>
  /* Custom prose overrides for the journal feel */
  .prose h2 {
    @apply text-lg font-bold border-b border-gray-100 dark:border-slate-800 pb-2 mt-12 mb-6;
  }
  .prose ul {
    @apply list-none pl-0 space-y-3 mb-8;
  }
  .prose li {
    @apply relative pl-6;
  }
  .prose li::before {
    content: "→";
    @apply absolute left-0 text-yellow-600 dark:text-yellow-500;
  }
  .prose blockquote {
    @apply border-l-2 border-yellow-500/30 pl-4 italic text-gray-500 dark:text-gray-400;
  }
</style>
