 panel.innerHTML=html;panel.dataset.phase=String(phase);panel.setAttribute('aria-labelledby','tab-'+lesson);
 $$('.lesson-progress [data-step]').forEach((el,i)=>{const step=phase===0?0:phase<3?1:2;el.classList.toggle('active',i===step);el.classList.toggle('complete',i<step);el.setAttribute('aria-current',i===step?'step':'false')});
