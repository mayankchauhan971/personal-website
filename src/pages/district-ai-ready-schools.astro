$$('[data-focus]').forEach(b=>b.addEventListener('click',()=>roomFocus(b.dataset.focus)));$('#reset-camera').addEventListener('click',()=>roomFocus(null));
function attachRoomControls(){
 const canvas=roomRenderer.canvas;let down=false,start=0,startAngle=0;
 canvas.addEventListener('pointerdown',e=>{down=true;start=e.clientX;startAngle=viewGoal.angle;canvas.setPointerCapture(e.pointerId);canvas.classList.add('dragging')});
 canvas.addEventListener('pointermove',e=>{if(!down)return;const dx=e.clientX-start;if(Math.abs(dx)<5)return;viewGoal.angle=clamp(startAngle+dx*.004,-.15,1.30);if(still)view.angle=viewGoal.angle;roomNeedsFrame=true;wake()});
 const up=()=>{down=false;canvas.classList.remove('dragging')};canvas.addEventListener('pointerup',up);canvas.addEventListener('pointercancel',up);canvas.addEventListener('lostpointercapture',up);
 canvas.addEventListener('keydown',e=>{if(e.key==='ArrowLeft'||e.key==='ArrowRight'){e.preventDefault();viewGoal.angle=clamp(viewGoal.angle+(e.key==='ArrowRight'?.10:-.10),-.15,1.30);if(still)view.angle=viewGoal.angle;roomNeedsFrame=true;wake()}else if(e.key==='Home'){e.preventDefault();roomFocus(null)}});
}
function positionHotspots(){
 if(!roomRenderer?.roomPV)return;const w=roomRenderer.w,h=roomRenderer.h;const offsets={teacher:[26,-30],ari:[-45,-8],ai:[-55,-35]};const placed=[];
 $$('[data-focus]').forEach(b=>{const role=b.dataset.focus,point=roomRenderer.project(roomRenderer.roomAnchors[role],roomRenderer.roomPV);let x=point.x+offsets[role][0],y=point.y+offsets[role][1];const bw=b.offsetWidth||75,bh=34;x=clamp(x,10,w-bw-10);y=clamp(y,60,h-70);
  for(const p of placed)if(Math.abs(p.x-x)<(p.w+bw)/2+8&&Math.abs(p.y-y)<36)y=clamp(p.y+40,60,h-66);
  placed.push({x,y,w:bw});b.style.opacity=point.visible?'1':'0';b.style.transform=`translate(${x.toFixed(1)}px,${y.toFixed(1)}px)`;
 });
}
function tick(now){
 raf=0;if(hidden)return;const start=performance.now(),dt=clamp((now-lastTime)/1000,.001,.065);lastTime=now;
 scrollCurrent=still?scrollTarget:mix(scrollCurrent,scrollTarget,1-Math.exp(-dt/.085));if(Math.abs(scrollTarget-scrollCurrent)<.12)scrollCurrent=scrollTarget;
