 const state={time:now/1000,still,camera:cameraAt(y),heroAlpha:1-smooth(.36*layoutH,.97*layoutH,y),heroMove:clamp(y/layoutH),geoAlpha:smooth(.33*layoutH,.94*layoutH,y)*(1-smooth(student.top-.55*layoutH,student.top+.06*layoutH,y)),studentAlpha:smooth(student.top-.55*layoutH,student.top+.03*layoutH,y)*(1-smooth(student.top+student.height-.72*layoutH,student.top+student.height-.2*layoutH,y)),studentQuestion:question};
 const mainKey=[Math.round(y*5),question,still,W,H].join('|');
 mainVisible=y<section('gap').top+30;
 if(mainVisible&&(mainKey!==lastMainKey||mainRenderer?.dirty)){
  mainRenderer?.render(state);lastMainKey=mainKey;$('#visual-stage').style.setProperty('--terrain-opacity',state.heroAlpha.toFixed(3));$('#visual-stage').style.setProperty('--veil-opacity',(state.studentAlpha>.1?.18:W<=600?.80:state.heroAlpha>.1?.42:.82).toString());updateGeography(state);
 }else if(!mainVisible){geoPlaces.forEach(p=>p.el.style.opacity='0');$('.geo-caption').style.opacity='0'}
 updateStoryText(scrollTarget);
 if(gapVisible&&gapRenderer){const key=W+'|'+H+'|'+gapRenderer.w+'|'+gapRenderer.h;if(key!==lastGapKey||gapRenderer.dirty){gapRenderer.render({comparison:true,time:now/1000,still});lastGapKey=key}}
 let roomMoving=false;
 for(const key of['angle','radius','height']){const d=viewGoal[key]-view[key];if(Math.abs(d)>.0004){view[key]=still?viewGoal[key]:mix(view[key],viewGoal[key],1-Math.exp(-dt/.13));roomMoving=true}else view[key]=viewGoal[key]}
 view.target=view.target.map((v,i)=>{const d=viewGoal.target[i]-v;if(Math.abs(d)>.0004){roomMoving=true;return still?viewGoal.target[i]:mix(v,viewGoal.target[i],1-Math.exp(-dt/.13))}return viewGoal.target[i]});
 if(roomVisible&&roomRenderer){
  const interval=roomRenderer.software?66:33;
  if(roomNeedsFrame||roomMoving||!still&&now-lastRoomTick>=interval){roomRenderer.render({classroom:true,time:now/1000,still,lessonPhase:phase,roomView:view});positionHotspots();roomNeedsFrame=false;lastRoomTick=now}
 }
 timings.push(performance.now()-start);if(timings.length>120)timings.shift();
 Object.assign(window.__jowai.state,{chapter:CHAPTERS[activeChapter]?.[0],camera:state.camera,scroll:scrollTarget,smoothedScroll:scrollCurrent,renderMode:mainRenderer?.software?'software-3d':'webgl',reducedMotion:still,lesson,lessonPhase:phase,roomVisible,gapVisible,view:{angle:view.angle,radius:view.radius},heroAlpha:state.heroAlpha,geoAlpha:state.geoAlpha,studentAlpha:state.studentAlpha});
 if(movingScroll||roomMoving||roomVisible&&!still)wake();
}
window.__jowai={version:2,state:{},errors,jump,openDialog,chooseLesson,roomFocus,render:()=>{lastMainKey='';lastGapKey='';roomNeedsFrame=true;wake()},performance:()=>({samples:timings.length,averageRenderMs:timings.reduce((a,b)=>a+b,0)/(timings.length||1),maxRenderMs:Math.max(0,...timings)}),renderers:()=>({main:mainRenderer,gap:gapRenderer,room:roomRenderer})};
const observer=new IntersectionObserver(entries=>{
 for(const entry of entries){if(entry.target.classList.contains('comparison-stage')){gapVisible=entry.isIntersecting;if(gapVisible&&!gapRenderer){gapRenderer=rendererFor($('#gap-canvas'));lastGapKey=''}}
  if(entry.target.id==='classroom-visual'){roomVisible=entry.isIntersecting;if(roomVisible&&!roomRenderer){roomRenderer=rendererFor($('#classroom-canvas'));roomRenderer?.updateLesson(lesson,phase);if(roomRenderer)attachRoomControls()}roomNeedsFrame=true}
 }wake();
},{rootMargin:'180px 0px',threshold:0});
observer.observe($('.comparison-stage'));observer.observe($('#classroom-visual'));
addEventListener('scroll',()=>{scrollTarget=scrollY;wake()},{passive:true});
let resizeTimer;addEventListener('resize',()=>{clearTimeout(resizeTimer);resizeTimer=setTimeout(()=>{if(Math.abs(innerWidth-W)>3||Math.abs(innerHeight-layoutH)>100)layoutH=innerHeight;measure()},120)},{passive:true});
