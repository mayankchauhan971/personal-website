$$('[data-lesson]').forEach(b=>b.addEventListener('click',()=>chooseLesson(b.dataset.lesson)));
function wireTabKeys(selector){const tabs=$$(selector);tabs.forEach((b,i)=>b.addEventListener('keydown',e=>{let next;if(e.key==='ArrowRight'||e.key==='ArrowDown')next=(i+1)%tabs.length;else if(e.key==='ArrowLeft'||e.key==='ArrowUp')next=(i+tabs.length-1)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();tabs[next].click();tabs[next].focus({preventScroll:true})}))}
wireTabKeys('[data-lesson]');
const delivery=[
 ['Start with the district\u2019s priorities.','The district nominates schools and teachers, confirms the academic calendar, and helps coordinate a suitable venue. The proposed coverage is refined together before delivery.'],
 ['Give teachers confidence they can use.','A 32.5-hour practical programme prepares teachers to use AI for classroom learning, creativity, exploration, career discovery and problem-solving, with responsible use built in. They leave with an AI toolkit and a classroom action plan.'],
