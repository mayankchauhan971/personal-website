$$('[data-delivery]').forEach(b=>b.addEventListener('click',()=>{const i=Number(b.dataset.delivery);$$('[data-delivery]').forEach(x=>{x.setAttribute('aria-selected',String(x===b));x.tabIndex=x===b?0:-1});$('#delivery-detail').innerHTML='<span class="detail-number">0'+(i+1)+'</span><div><h4>'+delivery[i][0]+'</h4><p>'+delivery[i][1]+'</p></div>';$('#delivery-detail').setAttribute('aria-labelledby',b.id);queueMeasure()}));
wireTabKeys('[data-delivery]');
function roomFocus(role){
 const views={teacher:{angle:.76,radius:8.5,height:4.7,target:[.65,1.28,-.15]},ari:{angle:.40,radius:8.2,height:4.4,target:[.05,1.02,.44]},ai:{angle:.60,radius:7.9,height:4.6,target:[.12,1.03,.28]}};
 viewGoal=role?{...views[role],target:[...views[role].target]}:{...DEFAULT_VIEW,target:[...DEFAULT_VIEW.target]};
 if(still)view={...viewGoal,target:[...viewGoal.target]};$$('[data-focus]').forEach(b=>b.classList.toggle('selected',b.dataset.focus===role));roomNeedsFrame=true;wake();
