---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "Consistency | Mayank Chauhan";
const description = "A reflection on intentionality, systems thinking, and sustainable self-improvement through consistency.";


const lessons = [
  {
    title: "Consistency beats intensity any given day",
    text: "I have always been proud of the fact that once I do something, I have the ability to lock in and focus on just one single thing over anything but I have realized this is not sustainable but just a receipe for burnout. Balance is what you need."
  },
  {
    title: "Transparency creates accountability",
    text: "Sharing your goals and progress creates a subtle layer of commitment. It's not about performance, but about being honest with oneself and hopefully insipre someone else to be too."
  },
  {
    title: "Missing one day matters less than quitting",
    text: "Life happens. Perfect streaks are possible but the cost might not always be worth it. Better to miss a few days and enjoy the thing rather than get stressed chasing perfection."
  },
  {
    title: "Compounding is a slow invisible process",
    text: "You don't see the tree grow, but one day it provides shade. Trust the process even when the results aren't obvious."
  }
];
---

<BaseLayout title={pageTitle} description={description}>
  <div class="max-w-6xl mx-auto px-6 py-16">
    <!-- Header Section -->
    <section class="mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6 font-mono">Consistency</h1>
      <p class="text-base text-gray-600 dark:text-gray-300 max-w-4xl leading-relaxed font-mono">
        Most meaningful things in life seem to compound slowly. This page is my attempt to make consistency visible — not as a measure of worth, but as a reminder to myself that small repeated actions matter. Building myself in public :)
      </p>
    </section>

    <!-- Habit Tracker Embed - Centered and constrained -->
    <section class="mb-24">
      <div class="max-w-[500px] mx-auto">
        <div class="rounded-2xl overflow-hidden border border-gray-200 dark:border-slate-800 bg-white dark:bg-slate-900/50 p-1 shadow-md">
          <div class="h-[600px] md:h-[850px] w-full">
             <iframe 
              src="https://showedup.vercel.app/mayank" 
              class="w-full h-full border-none transition-all duration-700"
              title="Public Habit Tracker"
            ></iframe>
          </div>
        </div>
        <p class="mt-4 text-sm text-gray-500 dark:text-gray-500 italic text-center font-mono font-light">
          Public since transparency creates accountability.
        </p>
      </div>
    </section>

    <!-- Lessons - Aligned to the right similar to Path page cards -->
    <section class="mb-24 pt-16 border-t border-gray-100 dark:border-slate-800">
      <div class="grid md:grid-cols-2 gap-8">
        <div class="hidden md:block">
          <!-- Left side empty to push content to the right -->
          <div class="sticky top-24">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4 font-mono">What I’ve Learned</h2>
            <p class="text-gray-500 dark:text-gray-400 font-mono text-sm leading-relaxed max-w-xs">
              Reflections on the journey of staying consistent and the systems that make it possible.
            </p>
          </div>
        </div>
        
        <div class="space-y-8">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-8 font-mono md:hidden">What I’ve Learned</h2>
          {lessons.map(lesson => (
            <div class="bg-white/60 dark:bg-slate-800/60 border border-gray-300 dark:border-slate-600 rounded-lg p-6 hover:bg-gray-100 dark:hover:bg-slate-700 transition-colors">
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2 font-mono">
                {lesson.title}
              </h3>
              <p class="text-base text-gray-500 dark:text-gray-400 font-mono leading-relaxed">
                {lesson.text}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Footer-like Links -->
    <footer class="pt-16 border-t border-gray-100 dark:border-slate-800">
      <div class="flex flex-wrap gap-8 font-mono">
        <a href="/articles" class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-2">
          Weekly Notes
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  /* Page transitions */
  div {
    animation: fadeIn 0.8s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  :global(html) {
    scroll-behavior: smooth;
  }
</style>
